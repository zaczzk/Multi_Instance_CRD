<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Chrome Remote Desktop - Lightweight ARM</ApplicationTitle>
    <AssemblyName>CRDLightweightARM</AssemblyName>
    <RootNamespace>CRDLightweightARM</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Optimized for Windows on ARM64 Snapdragon X Plus and x64 -->
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <!-- Strip satellite resource folders to eliminate bloat -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core WebView2 for WebRTC rendering -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="crd-mediator.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <Resource Include="app.ico" />
    <None Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
