<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Internal name kept so existing installs, settings (%LOCALAPPDATA%\CRDLightweightARM) and the installer keep working. -->
    <AssemblyName>CRDLightweightARM</AssemblyName>
    <RootNamespace>CRDLightweightARM</RootNamespace>
    <Product>Multi-Instance CRD</Product>
    <AssemblyTitle>Multi-Instance CRD</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Keep release output lean: no .pdb or package XML docs next to the app. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded only: a loose copy next to the exe could be swapped to inject script into signed-in sessions. -->
    <EmbeddedResource Include="crd-mediator.js" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- The WebView2 package also references a WinForms control this WPF app never loads. -->
  <Target Name="DropWebView2WinForms" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

</Project>
