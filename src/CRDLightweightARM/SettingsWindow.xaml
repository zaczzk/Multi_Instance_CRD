<Window x:Class="CRDLightweightARM.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-6,0,12"/>
        </Style>
    </Window.Resources>

    <Border Margin="16" Background="{StaticResource SurfaceSolidBrush}" BorderBrush="{StaticResource StrokeBrush}"
            BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (drag to move) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="24,18,12,6">
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <Button AutomationProperties.Name="Close" Style="{StaticResource IconButtonStyle}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right"
                        Click="Cancel_Click" ToolTip="Close (Esc)"/>
            </Grid>

            <!-- Scrolls only on short / high-DPI screens; header and footer stay put. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <Grid Margin="24,10,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sessions -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sessions" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldStyle}"
                                                 ToolTip="Leave blank to use the remote computer's name"/>
                                        <TextBlock Text="{Binding NamePlaceholder}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,8"/>
                                        <TextBlock Text="Start page" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldStyle}" FontSize="12"/>
                                        <TextBlock Text="{Binding UrlError}" Foreground="{StaticResource DangerBrush}" FontSize="11.5" Margin="0,4,0,0"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UrlError}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Behaviour + shortcuts -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Behaviour" Style="{StaticResource SectionTitle}"/>
                    <CheckBox x:Name="ChkPause" Style="{StaticResource ToggleSwitchStyle}" Content="Pause video in background sessions"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Saves power. Sessions stay connected and resume instantly."/>
                    <CheckBox x:Name="ChkPin" Style="{StaticResource ToggleSwitchStyle}" Content="Keep the top bar visible"/>
                    <TextBlock Style="{StaticResource Hint}" Text="When off, rest the pointer at the top edge to show it."/>
                    <CheckBox x:Name="ChkFullscreen" Style="{StaticResource ToggleSwitchStyle}" Content="Start in fullscreen"/>
                    <CheckBox x:Name="ChkTray" Style="{StaticResource ToggleSwitchStyle}" Content="Closing the window keeps it in the tray"/>
                    <CheckBox x:Name="ChkHotkey" Style="{StaticResource ToggleSwitchStyle}"/>

                    <TextBlock Text="Shortcuts" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="128"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Keys}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Margin="0,14,0,0" Padding="24,14" Background="#18181B" CornerRadius="0,0,10,10"
                    BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="TxtDataPath" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,230,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource DialogButtonStyle}" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0"/>
                        <Button x:Name="BtnSave" Content="Save" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
