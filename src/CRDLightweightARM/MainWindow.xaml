<Window x:Class="CRDLightweightARM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Multi-Instance CRD"
        Height="900" Width="1440"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        UseLayoutRounding="True">

    <Grid x:Name="RootGrid" Background="Black">
        <!-- Remote sessions. Column 2 is only used in split view. -->
        <Grid x:Name="WebViewContainer">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeft" Width="*"/>
                <ColumnDefinition x:Name="ColDivider" Width="0"/>
                <ColumnDefinition x:Name="ColRight" Width="0"/>
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="WebViewSession1" Grid.Column="0" Visibility="Visible"/>
            <wv2:WebView2 x:Name="WebViewSession2" Grid.Column="0" Visibility="Collapsed"/>
            <wv2:WebView2 x:Name="WebViewSession3" Grid.Column="0" Visibility="Collapsed"/>

            <GridSplitter x:Name="SplitDivider" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Background="#141416" Cursor="SizeWE" Visibility="Collapsed" Focusable="False"
                          ToolTip="Drag to resize · double-click to reset"
                          MouseDoubleClick="SplitDivider_MouseDoubleClick">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="{TemplateBinding Background}">
                            <Rectangle Width="1" Fill="#3A3A40"/>
                        </Grid>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>
        </Grid>

        <!--
            The top bar. At runtime it is moved into a small owned, non-activating window
            sized to the bar, so it floats above the WebView2 HWNDs without covering the rest of the screen.
        -->
        <Grid x:Name="BarRoot" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Border x:Name="Bar"
                    Margin="14,0,14,14"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1,0,1,1"
                    CornerRadius="0,0,10,10"
                    Padding="6,5"
                    MouseEnter="Bar_MouseEnter"
                    MouseLeave="Bar_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.5" RenderingBias="Performance"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="BarTransform" Y="0"/>
                </Border.RenderTransform>

                <StackPanel Orientation="Horizontal">
                    <!-- Sessions -->
                    <StackPanel x:Name="SessionPills" Orientation="Horizontal"/>

                    <Border Width="1" Height="18" Margin="6,0" Background="{StaticResource DividerBrush}" VerticalAlignment="Center"/>

                    <!-- View -->
                    <Button x:Name="BtnSplit" Style="{StaticResource IconButtonStyle}" Content="&#xE90C;" Click="BtnSplit_Click"/>
                    <Button x:Name="BtnFitMode" Style="{StaticResource IconButtonStyle}" Content="&#xE9A6;" Click="BtnFitMode_Click"/>
                    <Button x:Name="BtnKeys" Style="{StaticResource IconButtonStyle}" Content="&#xE765;" Click="BtnKeys_Click"
                            ToolTip="Send keys to the remote computer"/>

                    <Border Width="1" Height="18" Margin="6,0" Background="{StaticResource DividerBrush}" VerticalAlignment="Center"/>

                    <!-- Window -->
                    <Button x:Name="BtnFullscreen" Style="{StaticResource IconButtonStyle}" Content="&#xE740;" Click="BtnFullscreen_Click"/>
                    <Button x:Name="BtnPin" Style="{StaticResource IconButtonStyle}" Content="&#xE718;" Click="BtnPin_Click"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource IconButtonStyle}" Content="&#xE713;" Click="BtnSettings_Click"
                            ToolTip="Settings"/>
                    <Button x:Name="BtnHide" Style="{StaticResource IconButtonStyle}" Content="&#xE921;" Click="BtnHide_Click"/>
                </StackPanel>
            </Border>

            <!-- Thumbnail of a background session, shown when hovering its tab -->
            <Popup x:Name="ThumbnailPopup" Placement="Bottom" AllowsTransparency="True" StaysOpen="True"
                   VerticalOffset="10" PopupAnimation="Fade">
                <Border Background="{StaticResource SurfaceSolidBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="4" Cursor="Hand"
                        MouseEnter="ThumbnailPopup_MouseEnter" MouseLeave="ThumbnailPopup_MouseLeave"
                        PreviewMouseLeftButtonUp="ThumbnailPopup_Click">
                    <StackPanel>
                        <Border CornerRadius="5" ClipToBounds="True" Width="256" Height="160" Background="Black">
                            <Image x:Name="ImgThumbnail" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="TxtThumbnail" Margin="4,6,4,2" FontFamily="{StaticResource UiFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="256"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Send keys menu -->
            <Popup x:Name="KeysPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnKeys}"
                   AllowsTransparency="True" StaysOpen="False" VerticalOffset="10" PopupAnimation="Fade"
                   Closed="KeysPopup_Closed">
                <Border Width="240" Background="{StaticResource SurfaceSolidBrush}" BorderBrush="{StaticResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="4">
                    <StackPanel>
                        <Button Style="{StaticResource MenuRowStyle}" Click="BtnSendCtrlAltDel_Click">
                            <Grid>
                                <TextBlock Text="Ctrl + Alt + Del"/>
                                <TextBlock Text="Sign-in / security" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowStyle}" Click="BtnSendTaskManager_Click">
                            <Grid>
                                <TextBlock Text="Ctrl + Shift + Esc"/>
                                <TextBlock Text="Task Manager" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowStyle}" Click="BtnSendWin_Click">
                            <Grid>
                                <TextBlock Text="Windows key"/>
                                <TextBlock Text="Start menu" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MenuRowStyle}" Click="BtnSendWinD_Click">
                            <Grid>
                                <TextBlock Text="Win + D"/>
                                <TextBlock Text="Show desktop" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
