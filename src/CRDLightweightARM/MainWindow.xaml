<Window x:Class="CRDLightweightARM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Chrome Remote Desktop - Lightweight ARM"
        Height="900" Width="1440"
        WindowStyle="None"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}"
        Focusable="True"
        KeyDown="Window_KeyDown">

    <Grid x:Name="RootGrid">
        <!-- 1. WebRTC Remote Viewports (Zero Wasted Space - 100% Full Bleed) -->
        <Grid x:Name="WebViewContainer">
            <wv2:WebView2 x:Name="WebViewSession1" Visibility="Visible"/>
            <wv2:WebView2 x:Name="WebViewSession2" Visibility="Collapsed"/>
            <wv2:WebView2 x:Name="WebViewSession3" Visibility="Collapsed"/>
        </Grid>

        <!-- 2. Invisible Top Hover Trigger Area (Center 30%, 340px wide, 8px high) -->
        <Border x:Name="TopHoverTrigger"
                Width="340" Height="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="Transparent"
                MouseEnter="TopHoverTrigger_MouseEnter"
                MouseLeave="TopHoverTrigger_MouseLeave"/>

        <!-- 3. The Top Notch (Dynamic Island Dock) -->
        <Border x:Name="TopNotch"
                Width="380" Height="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{StaticResource NotchBackgroundBrush}"
                BorderBrush="{StaticResource NotchBorderBrush}"
                BorderThickness="1,0,1,1"
                CornerRadius="0,0,12,12"
                MouseEnter="TopNotch_MouseEnter"
                MouseLeave="TopNotch_MouseLeave">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" RenderingBias="Quality" ShadowDepth="4" Opacity="0.45"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="NotchTransform" Y="0"/>
            </Border.RenderTransform>

            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Notch Drag / Icon -->
                <TextBlock Grid.Column="0" Text="CRD" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" 
                           VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>

                <!-- Center: Session Slots -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Session 1 Pill -->
                    <Button x:Name="BtnSession1" Style="{StaticResource PillButtonStyle}" Click="BtnSession1_Click" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotSession1" Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="LabelSession1" Text="Session 1" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Session 2 Pill -->
                    <Button x:Name="BtnSession2" Style="{StaticResource PillButtonStyle}" Click="BtnSession2_Click" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotSession2" Width="8" Height="8" Fill="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="LabelSession2" Text="Session 2" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Session 3 Pill -->
                    <Button x:Name="BtnSession3" Style="{StaticResource PillButtonStyle}" Click="BtnSession3_Click" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotSession3" Width="8" Height="8" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="LabelSession3" Text="Session 3" FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: Settings & Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPin" Style="{StaticResource PillButtonStyle}" Click="BtnPin_Click" ToolTip="Toggle Pin / Auto-hide" Padding="6,2">
                        <TextBlock x:Name="TxtPin" Text="📌" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource PillButtonStyle}" Click="BtnSettings_Click" ToolTip="Settings (Ctrl+Alt+S)" Padding="6,2">
                        <TextBlock Text="⚙" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource PillButtonStyle}" Click="BtnFullscreen_Click" ToolTip="Toggle Fullscreen (F11)" Padding="6,2">
                        <TextBlock Text="⛶" FontSize="11"/>
                    </Button>
                    <Button Style="{StaticResource PillButtonStyle}" Click="BtnClose_Click" ToolTip="Close" Padding="6,2">
                        <TextBlock Text="✕" FontSize="11" Foreground="#FF6B6B"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Settings Overlay Modal -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#B0000000">
            <Border Width="520" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1E1E1E" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <TextBlock Text="Chrome Remote Desktop - Settings" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,16"/>

                        <!-- Efficiency Mode Selector -->
                        <TextBlock Text="Efficiency &amp; Swap Mode:" FontWeight="SemiBold" Foreground="#DDD" Margin="0,0,0,6"/>
                        <RadioButton x:Name="RadioUltraWarm" Content="⚡ Ultra-Warm: Instant wake (&lt;35ms), 0% GPU decode, fast memory (Recommended)" 
                                     Foreground="White" IsChecked="True" Margin="0,2,0,4"/>
                        <RadioButton x:Name="RadioEcoWarm" Content="🌱 Eco-Warm: Low RAM (~200ms wake), trims background working set" 
                                     Foreground="White" Margin="0,2,0,4"/>
                        <RadioButton x:Name="RadioLiveHot" Content="🔥 Live Hot: 0ms wake, all sessions continuously decode 60fps (Mains power)" 
                                     Foreground="White" Margin="0,2,0,14"/>

                        <Separator Background="#333" Margin="0,8,0,14"/>

                        <!-- Session 1 Config -->
                        <TextBlock Text="Session 1 Name &amp; URL:" Foreground="#DDD" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName1" Text="Session 1" Background="#2A2A2A" Foreground="White" BorderBrush="#444" Padding="6,4" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUrl1" Text="https://remotedesktop.google.com/access" Background="#2A2A2A" Foreground="#BBB" BorderBrush="#444" Padding="6,4" Margin="0,0,0,10"/>

                        <!-- Session 2 Config -->
                        <TextBlock Text="Session 2 Name &amp; URL:" Foreground="#DDD" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName2" Text="Session 2" Background="#2A2A2A" Foreground="White" BorderBrush="#444" Padding="6,4" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUrl2" Text="https://remotedesktop.google.com/access" Background="#2A2A2A" Foreground="#BBB" BorderBrush="#444" Padding="6,4" Margin="0,0,0,10"/>

                        <!-- Session 3 Config -->
                        <TextBlock Text="Session 3 Name &amp; URL:" Foreground="#DDD" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtName3" Text="Session 3" Background="#2A2A2A" Foreground="White" BorderBrush="#444" Padding="6,4" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtUrl3" Text="https://remotedesktop.google.com/access" Background="#2A2A2A" Foreground="#BBB" BorderBrush="#444" Padding="6,4" Margin="0,0,0,14"/>

                        <Separator Background="#333" Margin="0,4,0,14"/>

                        <!-- Hotkey Cheat Sheet -->
                        <TextBlock Text="Keyboard Shortcuts:" FontWeight="SemiBold" Foreground="#DDD" Margin="0,0,0,6"/>
                        <TextBlock Text="• Ctrl + Alt + [1..3]  : Jump directly to Session 1, 2, or 3" Foreground="#999" FontSize="11" Margin="0,1"/>
                        <TextBlock Text="• Ctrl + Alt + Tab   : Cycle to next active session" Foreground="#999" FontSize="11" Margin="0,1"/>
                        <TextBlock Text="• Ctrl + Alt + S     : Toggle Top Notch Dock" Foreground="#999" FontSize="11" Margin="0,1"/>
                        <TextBlock Text="• Ctrl + Alt + Home  : Release mouse lock / return to local host" Foreground="#999" FontSize="11" Margin="0,1"/>
                        <TextBlock Text="• F11                : Toggle borderless full screen" Foreground="#999" FontSize="11" Margin="0,1"/>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource PillButtonStyle}" Content="Cancel" Click="BtnSettingsCancel_Click" Margin="0,0,8,0" Padding="14,6"/>
                            <Button Style="{StaticResource PillButtonStyle}" Content="Save Settings" Click="BtnSettingsSave_Click" 
                                    Background="{StaticResource AccentBlueBrush}" Foreground="White" Padding="14,6"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
